# Vite public variables: safe to expose in browser bundles.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# IMPORTANT: Never put service role or email-provider secret keys in VITE_ variables.
# Set server secrets through: supabase secrets set NAME=value
# public-submit Edge Function (server-side):
# ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:5173
# SUBMISSION_SALT=(a strong random string)
# RESEND_API_KEY=(optional; real email delivery after verified domain setup)
# NOTIFY_ADMIN_EMAIL=
# NOTIFY_FROM_EMAIL=(verified sender domain)
